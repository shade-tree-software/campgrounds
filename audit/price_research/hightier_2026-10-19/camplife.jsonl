{"id": 12820, "url": "https://www.camplife.com/Cripple+Creek+Campground?newres=y", "read": "2026-10-19", "ref": ["name", "Cripple+Creek+Campground"], "record": {"images": [{"id": 2399482, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_9453e679-9778-4618-b52f-1bc03bf6578c.jpg", "contentType": "image", "primary": true, "caption": "KaMaKi Beach. Sweet and Salty Snack Shack", "textSummary": null}, {"id": 2399491, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_b21b4109-ef58-4b4b-8f9b-eb4bbb2123d8.jpg", "contentType": "image", "primary": false, "caption": "Sites B2,C1 & C2 A favorite area for group camping for larger trailers", "textSummary": null}, {"id": 2399489, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_4fc29eeb-4d73-4d9f-bf78-fb43c3373e00.jpg", "contentType": "image", "primary": false, "caption": "Site C2, along the creekside. Our most popular and favorited site by most of our campers!", "textSummary": "If you are lucky enough to get this site, we guarantee that you will return!!"}, {"id": 2115105, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/5512577_20260202T180640Z_bf45c8da-7ac9-4702-b623-bc56388cd4bf.jpg", "contentType": "image", "primary": false, "caption": "Sites A1.A2.B1 Great for a group of smaller trailers, popups and tents", "textSummary": null}, {"id": 2399557, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T205449Z_02028b03-ed9b-423a-9807-88155da0524b.jpg", "contentType": "image", "primary": false, "caption": "KaMaKi Beach. Beach Volleyball", "textSummary": null}, {"id": 2115103, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/5512577_20260202T180640Z_419898b1-437d-45fd-8cc4-cb9a5c80d6cf.jpg", "contentType": "image", "primary": false, "caption": "Beautiful KaMaKi Beach", "textSummary": null}, {"id": 2399484, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_977137d3-5adb-4041-b423-9b1dde480275.jpg", "contentType": "image", "primary": false, "caption": "Site C2, along the creekside. Our most popular and favorited site by most of our campers!", "textSummary": null}, {"id": 2115104, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/5512577_20260202T180640Z_984607d9-d660-41a3-a6c3-08dc2158c420.jpg", "contentType": "image", "primary": false, "caption": "Horse Shoe Pits", "textSummary": null}, {"id": 2399486, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_b03e260d-141d-4869-a440-1af4c0e40b34.jpg", "contentType": "image", "primary": false, "caption": "KaMaKi Beach. Beach Shelters. Available to book for just $25/day.", "textSummary": null}, {"id": 2399483, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_2a1273a3-2f15-4f2f-b10b-1c8095e03738.jpg", "contentType": "image", "primary": false, "caption": "Beach Shelters available on a 1st come basis or prebook to be guaranteed for only $25/day. Call/text 204-771-0242", "textSummary": null}, {"id": 2399487, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_11aead7b-c3a8-4767-966c-28a0292f4afd.jpg", "contentType": "image", "primary": false, "caption": "Beach Shelters available on a 1st come basis or prebook to be guaranteed for only $25/day. Call/text 204-771-0242", "textSummary": null}, {"id": 2399816, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T221623Z_5a60442c-fca0-43f2-9f06-1c71e5029e1d.jpg", "contentType": "image", "primary": false, "caption": "KaMaKi Beach. Beach Shelters. Available to book for just $25/day.", "textSummary": "Book by Island name. Call/Text 204-771-0242"}, {"id": 2399488, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_fc66c917-ebcb-45ce-90e1-cec5c0c07c48.jpg", "contentType": "image", "primary": false, "caption": "Milo Dog Park, Our Off leash dog park. Although not fenced, it is a fantastic area surrounded by trees along side the main entrance/exit where your beloved furr buddy can run FREE!!", "textSummary": null}, {"id": 2404603, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260628T231819Z_b4f08e76-0cc7-47ee-ba8c-ecbb96738693.jpg", "contentType": "image", "primary": false, "caption": "playground", "textSummary": null}, {"id": 2404604, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260628T231819Z_57d68475-6fdb-40ed-b650-dbd3c0e372db.jpg", "contentType": "image", "primary": false, "caption": "basketball", "textSummary": null}, {"id": 2399485, "url": "https://s3.amazonaws.com/sunriseimages-prod/static-app-content/cgs/7100219/images/campground/7100221_20260626T203610Z_3aa4e8b2-1591-45cd-9843-bb2e4c409e48.jpg", "contentType": "image", "primary": false, "caption": "Foam party at the beach. Fun as always", "textSummary": null}], "campgroundId": 7100219, "hasOnlineStore": false, "campgroundName": "Cripple Creek Campground", "primaryAddress": {"address1": "44154 Thurston Road", "address2": null, "city": "Richer", "stateProvince": "MB", "zipCode": "R0E 1S0"}, "phone": "+1 204-771-0242", "email": "info@cripplecreekcampground.com", "lat": "49.662149", "lon": "-96.32004", "facebookUrl": "https://www.facebook.com/share/1G38kD4Dvr/", "twitterId": "", "pinterestUrl": "", "instagramUrl": "https://cripple_creek_campground", "description": "<b><i>Cripple Creek Campground</i></b>, southeastern Manitoba’s best kept secret. Bringing nature back to camping We are located just 40 minutes east of Winnipeg on highway #1. A Seasonal and Overnight RV &amp; Tenting escape on 72 acres of heaven. Cripple Creek Campground is an ideal place of relaxation and summertime camping. Outdoor ENJOYment for families and travelers seeking nature and comfort in Manitoba’s beautiful, serene countryside. We offer guests a wide range of activities including our beautiful KaMaKi Beach, snack shack (open on weekends), outdoor lawn sports, beach volleyball, playground, social events and nearby tourist attractions. Enjoy your perfect getaway around an evening bonfire (firewood for sale on site), gaze up at the stars or enjoy a walk around the beautifully, maintained grounds.", "events": "<b><u>June 13th</u></b>&nbsp; Car Show and Snack Shack opens<p><br><p><u><b>July 4th</b></u>&nbsp; \"Canada Day Celebrations\" Foam Party, CCC Annual Rubber Boot Toss, Fireworks</p><p><b><u>August Long (July31st-3rd)&nbsp;</u></b> Foam Party,&nbsp;<span style=\"font-size: 1rem;\">Horse Shoe Tournament, Dart Tournament, Beach Games</span></p><p><span style=\"font-size: 1rem;\"><u><b>August 15th</b></u>&nbsp; Halloween; Trick or treating, Costume Dance w/DJ Gordo</span></p><p><b><u>September Long (Sept.4th-7th)</u></b>&nbsp; End of year Dance w/DJ Gordo</p><p>All above events Subject to change without notice</p><p><br></p><p><br></p></p>"}, "cg": 7100219, "name": "Cripple Creek Campground", "currency": "CAD", "config": {"siteTypes": [{"id": 101, "name": "Back-in", "equipTypeIds": [67, 6, 66, 64, 7, 12], "amenityIds": [7, 369, 359, 71, 24, 10]}, {"id": 4, "name": "Tent", "equipTypeIds": [6, 7, 12], "amenityIds": [359, 71, 24]}], "maxSites": 3, "encodedName": "Cripple+Creek+Campground", "campgroundPhone": "+1 204-771-0242", "campgroundAddress": "44154 Thurston Road\nRicher, MB R0E 1S0\nCanada", "allowFlexibleDa