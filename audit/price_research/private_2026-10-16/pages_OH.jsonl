\":{\"0\":\"http"]}, {"url": "https://campgrounds.rvlife.com/#/profile/auth", "lines": [], "via": "Submit a Campground"}, {"url": "https://campgrounds.rvlife.com/docs/ownerguidelines", "lines": [], "via": "Campground Owners"}]}
