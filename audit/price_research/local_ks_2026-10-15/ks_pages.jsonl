{"id": 2210, "name": "Airport Park (Concordia)", "read": "2026-10-15", "pages": [{"url": "https://concordiaks.org/departments/parks___recreation/parks/camping_-_airport_park.php", "lines": ["nd a fee-by-donation campsite for a stay up to 7 days. Four spots are designated as long term camping and can be reserved for up to 8 weeks. A permit is required which can be obtained at City Hall, along with payment of $150 per week. Longer term stays are a possibility with City Clerk approval. Utilities are available all year round and open to guests 24 hours a day. The scenic & wooded camping area includes 10 driv"]}, {"url": "https://concordiaks.org/departments/parks___recreation/parks/departments/fire___ems/services___programs/index.php", "error": "<HTTPError 404: 'Not Found'>"}, {"url": "https://concordiaks.org/departments/parks___recreation/parks/departments/police/services___programs/index.php", "error": "<HTTPError 404: 'Not Found'>"}, {"url": "https://concordiaks.org/departments/parks___recreation/parks/departments/utilities/water_conservation.php", "error": "<HTTPError 404: 'Not Found'>"}, {"url": "https://concordiaks.org/departments/parks___recreation/parks/services/index.php", "error": "<HTTPError 404: 'Not Found'>"}]}
